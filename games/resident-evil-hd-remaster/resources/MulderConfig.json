{
  "game": {
    "title": "Resident Evil HD Remaster",
    "originalExe": "bhd.exe"
  },
  "optionGroups": [
    {
      "name": "Graphical improvements",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "4K rendering for 3D assets" },
        { "value": "Real time graphics mod" },
        { "value": "Remove 120fps cap in \"Variable frame rate\"" }
      ]
    },
    {
      "name": "Other improvements",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "Gamecube Font Mod" },
        { "value": "Fast Door Skip" },
        { "value": "Remastered Inventory Icons" },
        { "value": "Weapons Sounds Mod" }
      ]
    },
    {
      "name": "Misc",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "DualShock 4 Icons" },
        { "value": "ERR09 Crash Fix" },
        { "value": "Performance boost" }
      ]
    }
  ],
  "actions": {
    "operations": [
      {
        "when": [ { "Graphical improvements": "4K rendering for 3D assets" } ],
        "operation": "copy",
        "source": "nativePC\\arc\\_ingamecommon.mod",
        "target": "nativePC\\arc\\ingamecommon.arc"
      },
      {
        "when": [ { "!Graphical improvements": "4K rendering for 3D assets" } ],
        "operation": "copy",
        "source": "nativePC\\arc\\_ingamecommon.ori",
        "target": "nativePC\\arc\\ingamecommon.arc"
      },



      {
        "when": [ ],
        "operation": "delete",
        "source": "d3d9.dll"
      },
      {
        "when": [ { "Graphical improvements": "Real time graphics mod" } ],
        "operation": "copy",
        "source": "_realtimegraphics.dll",
        "target": "d3d9.dll"
      },
      {
        "when": [ { "!Graphical improvements": "Real time graphics mod", "Misc": "ERR09 Crash Fix" } ],
        "operation": "copy",
        "source": "_crashfix.dll",
        "target": "d3d9.dll"
      },
      {
        "when": [ ],
        "operation": "replaceLine",
        "files": ["DX9Settings.ini"],
        "pattern": "ProxyLib",
        "replacement": ";ProxyLib = "
      },
      {
        "when": [ { "Graphical improvements": "Real time graphics mod", "Misc": "ERR09 Crash Fix" } ],
        "operation": "replaceLine",
        "files": ["DX9Settings.ini"],
        "pattern": "ProxyLib",
        "replacement": "ProxyLib = _crashfix.dll"
      },
      {
        "when": [ { "!*Graphical improvements": "Remove 120fps cap" } ],
        "operation": "replaceLine",
        "files": ["scripts\\ResidentEvil.FusionFix.ini"],
        "pattern": "UnlockFPS",
        "replacement": "UnlockFPS = 0"
      },
      {
        "when": [ { "*Graphical improvements": "Remove 120fps cap" } ],
        "operation": "replaceLine",
        "files": ["scripts\\ResidentEvil.FusionFix.ini"],
        "pattern": "UnlockFPS",
        "replacement": "UnlockFPS = 1"
      },



      {
        "when": [ { "!Other improvements": "Gamecube Font Mod" } ],
        "operation": "copy",
        "source": "nativePC\\arc\\id\\e_rom\\_common.ori",
        "target": "nativePC\\arc\\id\\e_rom\\common.arc"
      },
      {
        "when": [ { "Other improvements": "Gamecube Font Mod" } ],
        "operation": "copy",
        "source": "nativePC\\arc\\id\\e_rom\\_common.mod",
        "target": "nativePC\\arc\\id\\e_rom\\common.arc"
      },
      {
        "when": [ { "!Other improvements": "Fast Door Skip" } ],
        "operation": "replaceLine",
        "files": ["scripts\\ResidentEvil.FusionFix.ini"],
        "pattern": "DoorSkip",
        "replacement": "DoorSkip = 0"
      },
      {
        "when": [ { "Other improvements": "Fast Door Skip" } ],
        "operation": "replaceLine",
        "files": ["scripts\\ResidentEvil.FusionFix.ini"],
        "pattern": "DoorSkip",
        "replacement": "DoorSkip = 1"
      },
      {
        "when": [ { "!Other improvements": "Remastered Inventory Icons" } ],
        "operation": "copy",
        "source": "nativePC\\arc\\id\\e_rom\\subscr\\_itemicon.ori",
        "target": "nativePC\\arc\\id\\e_rom\\subscr\\itemicon.arc"
      },
      {
        "when": [ { "Other improvements": "Remastered Inventory Icons" } ],
        "operation": "copy",
        "source": "nativePC\\arc\\id\\e_rom\\subscr\\_itemicon.mod",
        "target": "nativePC\\arc\\id\\e_rom\\subscr\\itemicon.arc"
      },
      {
        "when": [ { "!Other improvements": "Weapons Sounds Mod" } ],
        "operation": "copy",
        "source": "nativePC\\arcPC\\sound\\se\\wep\\_wep02.ori",
        "target": "nativePC\\arcPC\\sound\\se\\wep\\wep02.arc"
      },
      {
        "when": [ { "!Other improvements": "Weapons Sounds Mod" } ],
        "operation": "copy",
        "source": "nativePC\\arcPC\\sound\\se\\wep\\_wep03.ori",
        "target": "nativePC\\arcPC\\sound\\se\\wep\\wep03.arc"
      },
      {
        "when": [ { "!Other improvements": "Weapons Sounds Mod" } ],
        "operation": "copy",
        "source": "nativePC\\arcPC\\sound\\se\\wep\\_wep04.ori",
        "target": "nativePC\\arcPC\\sound\\se\\wep\\wep04.arc"
      },
      {
        "when": [ { "Other improvements": "Weapons Sounds Mod" } ],
        "operation": "copy",
        "source": "nativePC\\arcPC\\sound\\se\\wep\\_wep02.mod",
        "target": "nativePC\\arcPC\\sound\\se\\wep\\wep02.arc"
      },
      {
        "when": [ { "Other improvements": "Weapons Sounds Mod" } ],
        "operation": "copy",
        "source": "nativePC\\arcPC\\sound\\se\\wep\\_wep03.mod",
        "target": "nativePC\\arcPC\\sound\\se\\wep\\wep03.arc"
      },
      {
        "when": [ { "Other improvements": "Weapons Sounds Mod" } ],
        "operation": "copy",
        "source": "nativePC\\arcPC\\sound\\se\\wep\\_wep04.mod",
        "target": "nativePC\\arcPC\\sound\\se\\wep\\wep04.arc"
      },



      {
        "when": [ { "Misc": "DualShock 4 Icons" } ],
        "operation": "copy",
        "source": ".MulderConfig\\DS4Icons\\nativePC\\arcPC\\id\\e_rom\\common.arc",
        "target": "nativePC\\arcPC\\id\\e_rom\\common.arc"
      },
      {
        "when": [ { "!Misc": "DualShock 4 Icons" } ],
        "operation": "copy",
        "source": ".MulderConfig\\Backup\\nativePC\\arcPC\\id\\e_rom\\common.arc",
        "target": "nativePC\\arcPC\\id\\e_rom\\common.arc"
      },
      {
        "when": [ { "!Misc": "Performance boost" } ],
        "operation": "replaceLine",
        "files": ["scripts\\ResidentEvil.FusionFix.ini"],
        "pattern": "DisableCreateQuery",
        "replacement": "DisableCreateQuery = 0"
      },
      {
        "when": [ { "Misc": "Performance boost" } ],
        "operation": "replaceLine",
        "files": ["scripts\\ResidentEvil.FusionFix.ini"],
        "pattern": "DisableCreateQuery",
        "replacement": "DisableCreateQuery = 1"
      }
    ]
  }
}
